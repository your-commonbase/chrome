{
  "manifest_version": 3,
  "name": "Your Commonbase",
  "description": "Your Commonbase Chrome Extension",
  "options_page": "options.html",
  "background": { "service_worker": "background.bundle.js" },
  "action": {
    "default_icon": "icon-128.png"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "<all_urls>"],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"]
    }
  ],
  "devtools_page": "devtools.html",
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Open YCB side panel search"
    },
    "open-ycb-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Open YCB dashboard"
    },
    "save-youtube-timestamp": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Save YouTube timestamp to YCB"
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "unlimitedStorage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.styles.css", "icon-128.png"],
      "matches": []
    }
  ]
}
